{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecci-paypal-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "SITE_NAME": "Energize Cult Cafe Inc.",
    "COMPANY_NAME": "Energize Cult Cafe Inc.",
    "COMPANY_EMAIL": "payments@energizecultcafe.com",
    "PAYPAL_CLIENT_ID": "sb",
    "PAYPAL_MERCHANT_ID": "M1234567890",
    "NODE_ENV": "production"
  },
  "env": {
    "production": {
      "name": "energize-cult-cafe-paypal-worker",
      "vars": {
        "SITE_NAME": "Energize Cult Cafe Inc.",
        "COMPANY_NAME": "Energize Cult Cafe Inc.",
        "COMPANY_EMAIL": "payments@energizecultcafe.com",
        "PAYPAL_CLIENT_ID": "sb",
        "PAYPAL_MERCHANT_ID": "M1234567890",
        "NODE_ENV": "production"
      }
    },
    "preview": {
      "name": "energize-cult-cafe-paypal-worker-preview",
      "vars": {
        "SITE_NAME": "Energize Cult Cafe Inc. (Preview)",
        "COMPANY_NAME": "Energize Cult Cafe Inc.",
        "COMPANY_EMAIL": "payments-dev@energizecultcafe.com",
        "PAYPAL_CLIENT_ID": "sb",
        "PAYPAL_MERCHANT_ID": "",
        "NODE_ENV": "development"
      }
    }
  },
  {
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
