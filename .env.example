# PayPal REST API Credentials (Server-side ONLY)
PAYPAL_CLIENT_ID="sb" # Set your live or sandbox PayPal Client ID
PAYPAL_CLIENT_SECRET="MY_PAYPAL_CLIENT_SECRET" # PayPal REST API Secret
PAYPAL_MERCHANT_ID="M1234567890" # Optional Merchant Account ID

# Environment Configuration
NODE_ENV="development" # development | production
SITE_URL="https://energize-cult-cafe-paypal-worker.pages.dev"

# Company & Site Branding
SITE_NAME="Energize Cult Cafe Inc."
COMPANY_NAME="Energize Cult Cafe Inc."
COMPANY_EMAIL="payments@energizecultcafe.com"

# Cloudflare & GitHub Deployment Secrets (Set in GitHub Secrets)
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""

# GEMINI_API_KEY: Optional for AI Studio runtime
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Runtime Cloud Run service URL
APP_URL="MY_APP_URL"

